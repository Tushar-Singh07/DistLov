# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For MongoDB Atlas (Production & Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/distlov?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/secureconnect

# Cloudinary Media Storage (Photos, Videos, Audio & Attachments)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=distlov_media

# Authentication & Security Secrets
AUTH_SECRET=your_super_secret_session_or_jwt_signing_key_here
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here
COOKIE_SECRET=your_super_secret_cookie_key_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Mailer Configuration (SMTP / Nodemailer)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@distlov.local

# WebRTC & Signaling Configuration
STUN_SERVER=stun:stun.l.google.com:19302

# Upload & File Limits
MAX_FILE_SIZE_BYTES=52428800
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50
MAX_AUDIO_SIZE_MB=25
MAX_DOCUMENT_SIZE_MB=25
